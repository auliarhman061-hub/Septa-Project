# ==========================================
# Sistem Informasi Akademik SMP
# Environment Variables Template
# ==========================================
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke repository.

# ─── Database ──────────────────────────────
# Neon PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST-DATABASE?sslmode=require
# Dapatkan dari: https://neon.tech → Dashboard → Connection Details
DATABASE_URL="postgresql://username:password@ep-xxx-xxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ─────────────────────────────────
# NextAuth
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# ─── App ──────────────────────────────────
# URL aplikasi (tanpa trailing slash)
# Local: http://localhost:3000
# Production Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
